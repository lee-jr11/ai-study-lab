# Copy this file to .env and fill in your values
# Never commit the .env file to Git

GEMINI_API_KEY=your_gemini_api_key_here

# Use a long random value in production so signed chat session tickets remain
# valid across workers and restarts. Local development can omit this and let
# the app generate an ignored .cleanup_secret file.
CLEANUP_SECRET=replace_with_a_long_random_value

# memory:// is fine for one local process. Use a shared Redis URL when running
# multiple workers or instances so per-user quotas are enforced globally.
RATELIMIT_STORAGE_URI=memory://

# NOTE: FLASK_DEBUG is intentionally NOT supported.
# The interactive debugger is permanently disabled for security
# (it allows remote code execution if ever exposed). Template
# auto-reload is always on for development convenience.
